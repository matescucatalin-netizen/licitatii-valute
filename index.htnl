<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Comandă Totală Mobilă</title>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Bebas+Neue&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Oswald', sans-serif; }
    body { background: #f1f5f9; color: #0f172a; padding: 10px; font-size: 14px; }
    .header { padding-bottom: 10px; border-bottom: 2px solid #cbd5e1; margin-bottom: 12px; }
    .title { font-family: 'Bebas Neue', sans-serif; font-size: 26px; color: #0284c7; text-align: center; }
    .status-bar { display: flex; justify-content: space-between; align-items: center; margin-top: 5px; }
    .clock { font-size: 13px; color: #64748b; font-weight: bold; }
    .alert-zone { font-size: 11px; color: #15803d; background: #dcfce7; padding: 2px 6px; border-radius: 4px; font-weight: bold; border: 1px solid #bbf7d0; }
    .fast-nav { display: flex; gap: 6px; margin-bottom: 15px; }
    .nav-btn { flex: 1; background: #e2e8f0; border: 1px solid #cbd5e1; color: #475569; text-align: center; padding: 10px 2px; border-radius: 6px; font-size: 11px; font-weight: bold; text-transform: uppercase; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
    .nav-btn.active { background: #0284c7; border-color: #0284c7; color: #fff; }
    .section-title { font-family: 'Bebas Neue', sans-serif; font-size: 22px; color: #b45309; margin-bottom: 10px; border-left: 4px solid #b45309; padding-left: 8px; }
    .section-container { display: none; background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 15px; }

    /* PLANNER */
    .planner-grid { display: flex; gap: 10px; margin-bottom: 12px; }
    .planner-col { flex: 1; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px; }
    .col-header { font-family: 'Bebas Neue', sans-serif; font-size: 22px; text-align: center; margin-bottom: 10px; padding: 4px; border-radius: 4px; }
    .col-sermirav { background: #2563eb; color: #fff; }
    .col-seba { background: #7c3aed; color: #fff; }
    .currency-block { background: #fff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px; margin-bottom: 10px; }
    .currency-title { font-size: 13px; font-weight: bold; text-align: center; padding: 2px 0; margin-bottom: 6px; border-bottom: 1px dashed #cbd5e1; }
    .title-ron { color: #b45309; } .title-usd { color: #0284c7; } .title-eur { color: #16a34a; }
    .input-label { font-size: 10px; color: #475569; font-weight: bold; text-transform: uppercase; margin-bottom: 2px; display: block; }
    .prog-input { width: 100%; background: #fff5f5; border: 1px solid #dc2626; color: #b91c1c; padding: 6px; border-radius: 4px; font-size: 14px; text-align: center; font-weight: bold; margin-bottom: 8px; }
    .withdrawal-inputs { display: flex; flex-direction: column; gap: 5px; }
    .withdraw-input { width: 100%; background: #fff; border: 1px solid #94a3b8; color: #0f172a; padding: 5px; border-radius: 4px; font-size: 13px; text-align: center; font-weight: bold; }
    .result-box { margin-top: 8px; background: #f1f5f9; padding: 6px; border-radius: 4px; text-align: center; border: 1px solid #cbd5e1; }
    .result-label { font-size: 10px; color: #475569; font-weight: bold; text-transform: uppercase; }
    .result-val { font-size: 15px; font-weight: 700; color: #16a34a; margin-top: 1px; }
    .result-val.low { color: #dc2626; }
    .action-btn-zone { display: flex; gap: 8px; margin-top: 10px; }
    .update-btn { flex: 2; background: #16a34a; color: #fff; border: none; font-family: 'Bebas Neue', sans-serif; font-size: 20px; padding: 10px; border-radius: 6px; cursor: pointer; }
    .clear-btn { flex: 1; background: #64748b; color: #fff; border: none; font-family: 'Bebas Neue', sans-serif; font-size: 20px; padding: 10px; border-radius: 6px; cursor: pointer; }

    /* CONCURENTA */
    .exchange-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px; margin-bottom: 12px; }
    .exchange-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .exchange-name { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: #0f172a; }
    .exchange-badge { font-size: 10px; font-weight: bold; padding: 2px 7px; border-radius: 10px; }
    .badge-vl { background: #ffedd5; color: #9a3412; }
    .badge-buc { background: #f3e8ff; color: #6b21a8; }
    .badge-bnk { background: #dbeafe; color: #1e40af; }
    .valutare-btn { background: #0284c7; color: #fff; text-decoration: none; padding: 6px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; display: inline-flex; align-items: center; gap: 4px; }

    .rates-table { width: 100%; border-collapse: collapse; }
    .rates-table thead tr { background: #e2e8f0; }
    .rates-table th { padding: 5px 4px; font-size: 11px; color: #475569; text-align: center; font-weight: bold; text-transform: uppercase; }
    .rates-table th:first-child { text-align: left; padding-left: 6px; }
    .rates-table td { padding: 4px; border-bottom: 1px solid #f1f5f9; }
    .rates-table td:first-child { font-weight: bold; font-size: 13px; padding-left: 6px; }
    .curr-flag { margin-right: 4px; }
    .rate-inp { width: 100%; background: #fff; border: 1px solid #cbd5e1; color: #0f172a; padding: 5px 3px; border-radius: 4px; font-size: 13px; text-align: center; font-weight: bold; font-family: 'Oswald', sans-serif; }
    .rate-inp:focus { border-color: #0284c7; outline: none; }
    .rate-inp.buy { border-left: 3px solid #16a34a; }
    .rate-inp.sell { border-left: 3px solid #dc2626; }

    /* highlight compare */
    .row-better { background: #f0fdf4; }
    .row-worse { background: #fef2f2; }

    .save-all-btn { width: 100%; background: #16a34a; color: #fff; border: none; font-family: 'Bebas Neue', sans-serif; font-size: 20px; padding: 12px; border-radius: 6px; cursor: pointer; margin-top: 5px; }
    .saved-ts { font-size: 10px; color: #94a3b8; text-align: center; margin-top: 5px; }

    .my-card { border: 2px solid #b45309; }
    .my-card .exchange-name { color: #b45309; }

    /* GRAFICE */
    .pct-grid { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
    .pct-row { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; }
    .pct-left { display: flex; flex-direction: column; gap: 2px; flex: 1; }
    .pct-pair { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: #0f172a; }
    .pct-desc { font-size: 10px; color: #64748b; }
    .pct-bar-wrap { height: 4px; background: #e2e8f0; border-radius: 2px; margin-top: 6px; overflow: hidden; }
    .pct-bar { height: 4px; border-radius: 2px; transition: width 0.5s; width: 50%; background: #94a3b8; }
    .pct-right { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; min-width: 90px; }
    .pct-val { font-size: 22px; font-weight: 700; }
    .pct-up { color: #16a34a; }
    .pct-down { color: #dc2626; }
    .pct-neutral { color: #64748b; }
    .pct-price { font-size: 12px; color: #475569; }
    .pct-ts { font-size: 10px; color: #94a3b8; text-align: right; margin-bottom: 12px; }
    .widget-box { background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; height: 480px; margin-bottom: 20px; overflow: hidden; }
    .widget-box iframe { width: 100%; height: 100%; border: none; }
    .chart-title { font-size: 14px; color: #334155; margin-bottom: 6px; font-weight: bold; }
  </style>
</head>
<body>

<div class="header">
  <div class="title">🎛️ COMANDA TOTALĂ MOBILĂ</div>
  <div class="status-bar">
    <div class="clock" id="liveClock">--:--:--</div>
    <div class="alert-zone" id="globalStatus">⚡ LIVE</div>
  </div>
</div>

<div class="fast-nav">
  <div class="nav-btn active" onclick="switchTab('banci-sectiune', this)">📅<br>Gestiune</div>
  <div class="nav-btn" onclick="switchTab('concurenta', this)">👑<br>Concurență</div>
  <div class="nav-btn" onclick="switchTab('forex', this)">📈<br>Grafice</div>
</div>

<!-- PLANNER -->
<div class="section-container" id="banci-sectiune" style="display:block;">
  <div class="section-title">Panou Gestiune Programări</div>
  <div class="planner-grid">
    <div class="planner-col">
      <div class="col-header col-sermirav">SERMIRAV</div>
      <div class="currency-block">
        <div class="currency-title title-ron">🇷🇴 RON</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="s_ron_prog" class="prog-input" placeholder="Ex: 300000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 3">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 4">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 5">
          <input type="number" class="withdraw-input s-ron-w" placeholder="Retragere 6">
        </div>
        <div class="result-box"><div class="result-label">Rest RON</div><div class="result-val" id="res_s_ron">0 lei</div></div>
      </div>
      <div class="currency-block">
        <div class="currency-title title-usd">🇺🇸 USD</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="s_usd_prog" class="prog-input" placeholder="Ex: 50000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input s-usd-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input s-usd-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input s-usd-w" placeholder="Retragere 3">
        </div>
        <div class="result-box"><div class="result-label">Rest USD</div><div class="result-val" id="res_s_usd">$0</div></div>
      </div>
      <div class="currency-block">
        <div class="currency-title title-eur">🇪🇺 EUR</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="s_eur_prog" class="prog-input" placeholder="Ex: 40000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input s-eur-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input s-eur-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input s-eur-w" placeholder="Retragere 3">
        </div>
        <div class="result-box"><div class="result-label">Rest EUR</div><div class="result-val" id="res_s_eur">€0</div></div>
      </div>
    </div>
    <div class="planner-col">
      <div class="col-header col-seba">SEBA</div>
      <div class="currency-block">
        <div class="currency-title title-ron">🇷🇴 RON</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="b_ron_prog" class="prog-input" placeholder="Ex: 300000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 3">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 4">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 5">
          <input type="number" class="withdraw-input b-ron-w" placeholder="Retragere 6">
        </div>
        <div class="result-box"><div class="result-label">Rest RON</div><div class="result-val" id="res_b_ron">0 lei</div></div>
      </div>
      <div class="currency-block">
        <div class="currency-title title-usd">🇺🇸 USD</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="b_usd_prog" class="prog-input" placeholder="Ex: 50000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input b-usd-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input b-usd-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input b-usd-w" placeholder="Retragere 3">
        </div>
        <div class="result-box"><div class="result-label">Rest USD</div><div class="result-val" id="res_b_usd">$0</div></div>
      </div>
      <div class="currency-block">
        <div class="currency-title title-eur">🇪🇺 EUR</div>
        <span class="input-label">Sumă Programată:</span>
        <input type="number" id="b_eur_prog" class="prog-input" placeholder="Ex: 40000">
        <span class="input-label">Retrageri:</span>
        <div class="withdrawal-inputs">
          <input type="number" class="withdraw-input b-eur-w" placeholder="Retragere 1">
          <input type="number" class="withdraw-input b-eur-w" placeholder="Retragere 2">
          <input type="number" class="withdraw-input b-eur-w" placeholder="Retragere 3">
        </div>
        <div class="result-box"><div class="result-label">Rest EUR</div><div class="result-val" id="res_b_eur">€0</div></div>
      </div>
    </div>
  </div>
  <div class="action-btn-zone">
    <button class="update-btn" onclick="saveAndCalculate()">🔄 Actualizează</button>
    <button class="clear-btn" onclick="clearPlanner()">❌ Șterge</button>
  </div>
</div>

<!-- CONCURENTA -->
<div class="section-container" id="concurenta">
  <div class="section-title">Cursuri Concurență</div>

  <!-- SERMIRAV - cursurile mele de referinta -->
  <div class="exchange-card my-card">
    <div class="exchange-card-header">
      <span class="exchange-name">⭐ Sermirav (Tu)</span>
      <span class="exchange-badge badge-vl">📍 REFERINȚĂ</span>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy" id="my_eur_buy" placeholder="5.20" step="0.001"></td><td><input type="number" class="rate-inp sell" id="my_eur_sell" placeholder="5.30" step="0.001"></td></tr>
        <tr><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy" id="my_usd_buy" placeholder="4.50" step="0.001"></td><td><input type="number" class="rate-inp sell" id="my_usd_sell" placeholder="4.60" step="0.001"></td></tr>
        <tr><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy" id="my_gbp_buy" placeholder="5.90" step="0.001"></td><td><input type="number" class="rate-inp sell" id="my_gbp_sell" placeholder="6.10" step="0.001"></td></tr>
        <tr><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy" id="my_chf_buy" placeholder="5.60" step="0.001"></td><td><input type="number" class="rate-inp sell" id="my_chf_sell" placeholder="5.80" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- OPTIM -->
  <div class="exchange-card" id="card-optim">
    <div class="exchange-card-header">
      <span class="exchange-name">Optim Exchange</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-vl">📍 VÂLCEA</span>
        <a href="https://www.valutare.ro/curs/numar-telefon-adresa-optim-exchange.html" target="_blank" class="valutare-btn">↗️ Valutare</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="optim-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="optim_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="optim_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="optim-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="optim_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="optim_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="optim-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="optim_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="optim_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="optim-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="optim_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="optim_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- FAMILY -->
  <div class="exchange-card" id="card-family">
    <div class="exchange-card-header">
      <span class="exchange-name">Family Exchange</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-vl">📍 OSTROVENI</span>
        <a href="https://www.valutare.ro/curs/numar-telefon-adresa-family-exchange-ostroveni-cina-luceafarului5-.html" target="_blank" class="valutare-btn">↗️ Valutare</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="family-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="family_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="family_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="family-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="family_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="family_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="family-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="family_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="family_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="family-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="family_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="family_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- AZAD -->
  <div class="exchange-card" id="card-azad">
    <div class="exchange-card-header">
      <span class="exchange-name">Azad Exchange</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-buc">📍 BUC. UNIRII</span>
        <a href="https://www.valutare.ro/curs/numar-telefon-adresa-azad-exchange-srl-unirii.html" target="_blank" class="valutare-btn">↗️ Valutare</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="azad-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="azad_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="azad_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="azad-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="azad_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="azad_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="azad-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="azad_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="azad_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="azad-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="azad_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="azad_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- HOLUX -->
  <div class="exchange-card" id="card-holux">
    <div class="exchange-card-header">
      <span class="exchange-name">Holux București</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-buc">📍 BUCUREȘTI</span>
        <a href="https://www.valutare.ro/curs/numar-telefon-adresa-Holux-bucuresti.html" target="_blank" class="valutare-btn">↗️ Valutare</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="holux-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="holux_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="holux_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="holux-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="holux_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="holux_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="holux-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="holux_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="holux_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="holux-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="holux_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="holux_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- CEC -->
  <div class="exchange-card" id="card-cec">
    <div class="exchange-card-header">
      <span class="exchange-name">CEC Bank</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-bnk">🏦 BANCĂ</span>
        <a href="https://www.cec.ro/curs-valutar" target="_blank" class="valutare-btn">↗️ Site CEC</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="cec-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="cec_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="cec_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="cec-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="cec_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="cec_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="cec-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="cec_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="cec_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="cec-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="cec_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="cec_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <!-- EXIM -->
  <div class="exchange-card" id="card-exim">
    <div class="exchange-card-header">
      <span class="exchange-name">Exim Bank</span>
      <div style="display:flex;gap:6px;align-items:center;">
        <span class="exchange-badge badge-bnk">🏦 BANCĂ</span>
        <a href="https://eximbank.ro/curs-valutar/" target="_blank" class="valutare-btn">↗️ Site Exim</a>
      </div>
    </div>
    <table class="rates-table">
      <thead><tr><th>Valută</th><th>Cumpără</th><th>Vinde</th></tr></thead>
      <tbody>
        <tr id="exim-eur-row"><td><span class="curr-flag">🇪🇺</span>EUR</td><td><input type="number" class="rate-inp buy comp-inp" data-id="exim_eur_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="exim_eur_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="exim-usd-row"><td><span class="curr-flag">🇺🇸</span>USD</td><td><input type="number" class="rate-inp buy comp-inp" data-id="exim_usd_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="exim_usd_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="exim-gbp-row"><td><span class="curr-flag">🇬🇧</span>GBP</td><td><input type="number" class="rate-inp buy comp-inp" data-id="exim_gbp_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="exim_gbp_sell" placeholder="—" step="0.001"></td></tr>
        <tr id="exim-chf-row"><td><span class="curr-flag">🇨🇭</span>CHF</td><td><input type="number" class="rate-inp buy comp-inp" data-id="exim_chf_buy" placeholder="—" step="0.001"></td><td><input type="number" class="rate-inp sell comp-inp" data-id="exim_chf_sell" placeholder="—" step="0.001"></td></tr>
      </tbody>
    </table>
  </div>

  <button class="save-all-btn" onclick="saveAndCompare()">💾 Salvează & Compară</button>
  <div class="saved-ts" id="saved-ts">—</div>
</div>

<!-- GRAFICE -->
<div class="section-container" id="forex">
  <div class="section-title">Variații Live RON</div>

  <div class="pct-grid">
    <div class="pct-row">
      <div class="pct-left">
        <span class="pct-pair">🇪🇺 EUR / RON</span>
        <span class="pct-desc">Euro față de Leu</span>
        <div class="pct-bar-wrap"><div class="pct-bar" id="bar-eur"></div></div>
      </div>
      <div class="pct-right">
        <span class="pct-val pct-neutral" id="pct-eur">—</span>
        <span class="pct-price" id="price-eur">—</span>
      </div>
    </div>
    <div class="pct-row">
      <div class="pct-left">
        <span class="pct-pair">🇺🇸 USD / RON</span>
        <span class="pct-desc">Dolar față de Leu</span>
        <div class="pct-bar-wrap"><div class="pct-bar" id="bar-usd"></div></div>
      </div>
      <div class="pct-right">
        <span class="pct-val pct-neutral" id="pct-usd">—</span>
        <span class="pct-price" id="price-usd">—</span>
      </div>
    </div>
    <div class="pct-row">
      <div class="pct-left">
        <span class="pct-pair">🇬🇧 GBP / RON</span>
        <span class="pct-desc">Liră față de Leu</span>
        <div class="pct-bar-wrap"><div class="pct-bar" id="bar-gbp"></div></div>
      </div>
      <div class="pct-right">
        <span class="pct-val pct-neutral" id="pct-gbp">—</span>
        <span class="pct-price" id="price-gbp">—</span>
      </div>
    </div>
    <div class="pct-row">
      <div class="pct-left">
        <span class="pct-pair">🇨🇭 CHF / RON</span>
        <span class="pct-desc">Franc față de Leu</span>
        <div class="pct-bar-wrap"><div class="pct-bar" id="bar-chf"></div></div>
      </div>
      <div class="pct-right">
        <span class="pct-val pct-neutral" id="pct-chf">—</span>
        <span class="pct-price" id="price-chf">—</span>
      </div>
    </div>
  </div>
  <div class="pct-ts" id="pct-ts">se încarcă...</div>

  <div class="chart-title">📊 EUR / RON (15 Min)</div>
  <div class="widget-box"><iframe src="https://s.tradingview.com/widgetembed/?frameElementId=tv1&symbol=FX_IDC%3AEURRON&interval=15&theme=light&style=1&timezone=Europe%2FBucharest" allowtransparency="true"></iframe></div>
  <div class="chart-title">📊 USD / RON (15 Min)</div>
  <div class="widget-box"><iframe src="https://s.tradingview.com/widgetembed/?frameElementId=tv2&symbol=FX_IDC%3AUSDRON&interval=15&theme=light&style=1&timezone=Europe%2FBucharest" allowtransparency="true"></iframe></div>
  <div class="chart-title">📊 GBP / RON (15 Min)</div>
  <div class="widget-box"><iframe src="https://s.tradingview.com/widgetembed/?frameElementId=tv3&symbol=FX_IDC%3AGBPRON&interval=15&theme=light&style=1&timezone=Europe%2FBucharest" allowtransparency="true"></iframe></div>
  <div class="chart-title">📊 CHF / RON (15 Min)</div>
  <div class="widget-box"><iframe src="https://s.tradingview.com/widgetembed/?frameElementId=tv4&symbol=FX_IDC%3ACHFRON&interval=15&theme=light&style=1&timezone=Europe%2FBucharest" allowtransparency="true"></iframe></div>
</div>

<script>
  function switchTab(id, el) {
    document.querySelectorAll(".section-container").forEach(s => s.style.display = "none");
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
    document.getElementById(id).style.display = "block";
    el.classList.add("active");
    window.scrollTo({top:0, behavior:"smooth"});
  }

  // ===== CONCURENTA =====
  const competitors = ["optim","family","azad","holux","cec","exim"];
  const currencies = ["eur","usd","gbp","chf"];

  function saveAndCompare() {
    const data = {};
    // salvam cursurile mele
    ["my_eur_buy","my_eur_sell","my_usd_buy","my_usd_sell","my_gbp_buy","my_gbp_sell","my_chf_buy","my_chf_sell"].forEach(id => {
      data[id] = document.getElementById(id).value;
    });
    // salvam cursurile concurentilor
    document.querySelectorAll(".comp-inp").forEach(inp => {
      data[inp.getAttribute("data-id")] = inp.value;
    });
    localStorage.setItem("compData_v3", JSON.stringify(data));
    applyHighlights(data);
    document.getElementById("saved-ts").innerText = "✅ Salvat la " + new Date().toLocaleString("ro-RO");
  }

  function applyHighlights(data) {
    competitors.forEach(comp => {
      currencies.forEach(curr => {
        const rowId = comp + "-" + curr + "-row";
        const row = document.getElementById(rowId);
        if (!row) return;
        const myBuy = parseFloat(data["my_" + curr + "_buy"]) || 0;
        const compBuy = parseFloat(data[comp + "_" + curr + "_buy"]) || 0;
        if (!myBuy || !compBuy) { row.className = ""; return; }
        // ei cumpara mai mult = mai bun pentru client = rau pentru noi
        row.className = compBuy > myBuy ? "row-worse" : "row-better";
      });
    });
  }

  function loadCompData() {
    const raw = localStorage.getItem("compData_v3");
    if (!raw) return;
    const data = JSON.parse(raw);
    ["my_eur_buy","my_eur_sell","my_usd_buy","my_usd_sell","my_gbp_buy","my_gbp_sell","my_chf_buy","my_chf_sell"].forEach(id => {
      const el = document.getElementById(id);
      if (el && data[id]) el.value = data[id];
    });
    document.querySelectorAll(".comp-inp").forEach(inp => {
      const key = inp.getAttribute("data-id");
      if (data[key]) inp.value = data[key];
    });
    applyHighlights(data);
  }

  // ===== PROCENTE LIVE =====
  let firstRates = null;

  async function fetchProcente() {
    try {
      const res = await fetch("https://open.er-api.com/v6/latest/EUR");
      const d = await res.json();
      if (!d || !d.rates) return;
      const eur = d.rates.RON;
      const usd = eur / d.rates.USD;
      const gbp = eur / d.rates.GBP;
      const chf = eur / d.rates.CHF;
      const current = { eur, usd, gbp, chf };
      if (!firstRates) firstRates = { ...current };

      Object.keys(current).forEach(key => {
        const val = current[key];
        const base = firstRates[key];
        const pct = ((val - base) / base) * 100;
        const pctEl = document.getElementById("pct-" + key);
        const priceEl = document.getElementById("price-" + key);
        const barEl = document.getElementById("bar-" + key);
        priceEl.innerText = val.toFixed(4) + " lei";
        if (Math.abs(pct) < 0.0001) {
          pctEl.innerText = "0.00%";
          pctEl.className = "pct-val pct-neutral";
          barEl.style.width = "50%";
          barEl.style.background = "#94a3b8";
        } else if (pct > 0) {
          pctEl.innerText = "+" + pct.toFixed(3) + "%";
          pctEl.className = "pct-val pct-up";
          barEl.style.width = Math.min(50 + Math.abs(pct) * 30, 95) + "%";
          barEl.style.background = "#16a34a";
        } else {
          pctEl.innerText = pct.toFixed(3) + "%";
          pctEl.className = "pct-val pct-down";
          barEl.style.width = Math.max(50 - Math.abs(pct) * 30, 5) + "%";
          barEl.style.background = "#dc2626";
        }
      });
      document.getElementById("pct-ts").innerText = "Live • Actualizat: " + new Date().toLocaleTimeString("ro-RO");
      document.getElementById("globalStatus").innerText = "✅ LIVE";
    } catch(e) {
      document.getElementById("pct-ts").innerText = "Eroare date live";
    }
  }

  // ===== PLANNER =====
  function saveAndCalculate() {
    let d = {};
    ["s_ron_prog","s_usd_prog","s_eur_prog","b_ron_prog","b_usd_prog","b_eur_prog"].forEach(id => { d[id] = document.getElementById(id).value; });
    ["s-ron-w","s-usd-w","s-eur-w","b-ron-w","b-usd-w","b-eur-w"].forEach(cls => { d[cls] = Array.from(document.querySelectorAll("."+cls)).map(i=>i.value); });
    localStorage.setItem("plannerData_v6", JSON.stringify(d));
    executeMath(d);
  }
  function executeMath(d) {
    function sum(arr) { return (arr||[]).reduce((a,v)=>a+(parseFloat(v)||0),0); }
    upd("res_s_ron",(parseFloat(d["s_ron_prog"])||0)-sum(d["s-ron-w"])," lei");
    upd("res_s_usd",(parseFloat(d["s_usd_prog"])||0)-sum(d["s-usd-w"])," $");
    upd("res_s_eur",(parseFloat(d["s_eur_prog"])||0)-sum(d["s-eur-w"])," €");
    upd("res_b_ron",(parseFloat(d["b_ron_prog"])||0)-sum(d["b-ron-w"])," lei");
    upd("res_b_usd",(parseFloat(d["b_usd_prog"])||0)-sum(d["b-usd-w"])," $");
    upd("res_b_eur",(parseFloat(d["b_eur_prog"])||0)-sum(d["b-eur-w"])," €");
  }
  function upd(id, val, sym) {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerText = val.toLocaleString("ro-RO") + sym;
    val < 0 ? el.classList.add("low") : el.classList.remove("low");
  }
  function loadSavedData() {
    const raw = localStorage.getItem("plannerData_v6"); if (!raw) return;
    const d = JSON.parse(raw);
    ["s_ron_prog","s_usd_prog","s_eur_prog","b_ron_prog","b_usd_prog","b_eur_prog"].forEach(id => { if(d[id]) document.getElementById(id).value = d[id]; });
    ["s-ron-w","s-usd-w","s-eur-w","b-ron-w","b-usd-w","b-eur-w"].forEach(cls => {
      if(d[cls]) document.querySelectorAll("."+cls).forEach((inp,i) => { if(d[cls][i]) inp.value = d[cls][i]; });
    });
    executeMath(d);
  }
  function clearPlanner() {
    if(confirm("Ștergi toate datele?")) {
      localStorage.removeItem("plannerData_v6");
      document.querySelectorAll(".prog-input,.withdraw-input").forEach(i=>i.value="");
      executeMath({});
    }
  }

  window.onload = function() {
    loadSavedData();
    loadCompData();
    fetchProcente();
    setInterval(fetchProcente, 30000);
  };
  setInterval(() => { document.getElementById("liveClock").innerText = new Date().toLocaleTimeString("ro-RO"); }, 1000);
</script>
</body>
</html>
